{
  "config": {
    "step": {
      "user": {
        "title": "Host Monitor",
        "description": "Monitor the Linux host through the directories mounted read-only into the Home Assistant container:\n\n- `{proc}`\n- `{sys}`\n- `{root}`\n\nFor accurate network statistics the container must use host networking (`network_mode: host`)."
      }
    },
    "error": {
      "not_mounted": "Host system directories are not mounted. Mount /proc, /sys and / read-only at /host/proc, /host/sys and /host/root."
    },
    "abort": {
      "already_configured": "Host Monitor is already configured."
    }
  },
  "entity": {
    "sensor": {
      "cpu_usage": { "name": "CPU usage" },
      "load_1m": { "name": "Load (1 min)" },
      "load_5m": { "name": "Load (5 min)" },
      "load_15m": { "name": "Load (15 min)" },
      "memory_usage": { "name": "Memory usage" },
      "memory_used": { "name": "Memory used" },
      "memory_available": { "name": "Memory available" },
      "memory_total": { "name": "Memory total" },
      "disk_usage": { "name": "Disk usage" },
      "disk_used": { "name": "Disk used" },
      "disk_free": { "name": "Disk free" },
      "disk_total": { "name": "Disk total" },
      "network_rx": { "name": "Network received" },
      "network_tx": { "name": "Network sent" },
      "network_rx_rate": { "name": "Network receive rate" },
      "network_tx_rate": { "name": "Network transmit rate" },
      "cpu_temperature": { "name": "CPU temperature" },
      "uptime": { "name": "Uptime" }
    }
  }
}
